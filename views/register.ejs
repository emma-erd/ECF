<%- include ('partials/header'); -%>

    <main class="mt-20 mb-20 md:mt-30 md:mb-20">
        
        <div class="mx-4">
            <form class="max-w-sm mx-auto p-6 rounded-base shadow-md bg-orange-50">
                <h5 class="text-xl font-semibold text-heading text-orange-700/65 mb-6">Enregistrez-vous</h5>
                <div class="grid md:grid-cols-2 md:gap-6">
                    <div class="mb-4">
                        <label for="firstName" class="block mb-2.5 text-sm font-medium text-heading">Prénom</label>
                        <input type="text" id="firstName" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="Pauline" required />
                    </div>
                    <div class="mb-4">
                        <label for="lastName" class="block mb-2.5 text-sm font-medium text-heading">Nom de famille</label>
                        <input type="text" id="lastName" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="Dupont" required />
                    </div>
                </div>
                <div class="mb-4">
                    <label for="email" class="block mb-2.5 text-sm font-medium text-heading">Votre email</label>
                    <input type="email" id="email" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="exemple@entreprise.com" required />
                </div>
                <div class="mb-4">
                    <label for="password" class="block mb-2.5 text-sm font-medium text-heading">Votre mot de passe</label>
                    <input type="password" id="password" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="•••••••••" required />
                </div>
                <div class="grid md:grid-cols-2 md:gap-6">
                    <div class="mb-4">
                        <label for="phone" class="block mb-2.5 text-sm font-medium text-heading">Téléphone</label>
                        <input type="tel" pattern="0[1-9](?: [0-9]{2}){4}" id="phone" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="01 23 45 67 89" required />
                    </div>
                    <div class="mb-4">
                        <label for="postalCode" class="block mb-2.5 text-sm font-medium text-heading">Code postal</label>
                        <input type="number" max="5" id="postalCode" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="33000" required />
                    </div>
                </div>
                <div class="mb-4">
                    <label for="street" class="block mb-2.5 text-sm font-medium text-heading">Votre adresse</label>
                    <input type="text" id="street" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="1 rue principale" required />
                </div>
                <div class="mb-6">
                    <label for="city" class="block mb-2.5 text-sm font-medium text-heading">Ville / Commune</label>
                    <input type="text" id="city" class="border text-heading text-sm rounded-base block w-full px-3 py-2.5 shadow-xs" placeholder="Bordeaux" required />
                </div>
                <button type="submit" class="text-white text-sm bg-orange-700/65 shadow-xs font-medium rounded-base hover:bg-amber-700 px-4 py-2.5 w-full mb-6">Envoyer</button>
                <div class="text-sm font-medium text-body">Déjà un compte? <a href="/login" class="text-orange-700/65 hover:underline">Se connecter</a></div>
            </form>
        </div>

    </main>

<%- include ('partials/footer'); -%>