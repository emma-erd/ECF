<%- include ('../partials/header'); -%>


    <button command="show-modal" commandfor="drawer" class="md:mt-20 md:mb-4 md:mx-14 text-heading bg-transparent font-medium leading-5 rounded-base ms-3 mt-3 text-sm p-2 focus:outline-none inline-flex lg:hidden">
        <span class="sr-only">Open sidebar</span>
            <svg class="w-6 h-6" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M5 7h14M5 12h14M5 17h10"/>
            </svg>
    </button>

    <el-dialog>
        <dialog id="drawer" aria-labelledby="drawer-title" class="fixed inset-0 size-auto max-h-none max-w-none overflow-hidden bg-transparent not-open:hidden backdrop:bg-transparent lg:hidden">
            <el-dialog-backdrop class="absolute inset-0 bg-gray-500/75 transition-opacity duration-500 ease-in-out data-closed:opacity-0"></el-dialog-backdrop>

            <div tabindex="0" class="absolute inset-0 pr-10 focus:outline-none sm:pr-16">
            <el-dialog-panel class="group/dialog-panel relative mr-auto block size-full max-w-md transform transition duration-500 ease-in-out data-closed:translate-x-full sm:duration-700">
                
                <div class="absolute top-0 right-0 -mr-8 flex pt-4 pl-2 duration-500 ease-in-out group-data-closed/dialog-panel:opacity-0 sm:-mr-10 sm:pl-4">
                    <button type="button" command="close" commandfor="drawer" class="relative rounded-md text-gray-300 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                        <span class="absolute -inset-2.5"></span>
                        <span class="sr-only">Close panel</span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6">
                            <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </button>
                </div>

                <div class="relative flex h-full flex-col overflow-y-auto bg-white py-6 shadow-xl after:absolute after:inset-y-0 after:left-0 after:w-px after:bg-white/10">
                    <div class="px-4">
                        <h2 id="drawer-title" class="text-base font-semibold text-orange-700/65">Dashboard</h2>
                    </div>
                    <div class="relative mt-6 flex-1 px-10">
                        <ul class="space-y-2 font-medium">
                            <li class="active:text-orange-700/65">
                                <a href="/admin/orders" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                                    <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 13h3.439a.991.991 0 0 1 .908.6 3.978 3.978 0 0 0 7.306 0 .99.99 0 0 1 .908-.6H20M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6M4 13l2-9h12l2 9M9 7h6m-7 3h8"/></svg>
                                    <span class="flex-1 ms-3 whitespace-nowrap">Commandes</span>
                                </a>
                            </li>
                            <li class="text-orange-700/65">
                                <a href="/admin/employees" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                                    <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.236-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                                    <span class="flex-1 ms-3 whitespace-nowrap">Employés</span>
                                </a>
                            </li>
                            <li class="active:text-orange-700/65">
                                <a href="/admin/products" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                                    <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10V6a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v4m3-2 .917 11.923A1 1 0 0 1 17.92 21H6.08a1 1 0 0 1-.997-1.077L6 8h12Z"/></svg>
                                    <span class="flex-1 ms-3 whitespace-nowrap">Produits</span>
                                </a>
                            </li>
                            <li class="active:text-orange-700/65">
                                <a href="/admin/comments" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                                    <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v14M9 5v14M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
                                    <span class="flex-1 ms-3 whitespace-nowrap">Commentaires</span>
                                </a>
                            </li>
                            <li class="active:text-orange-700/65">
                                <a href="/admin/stats" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                                    <svg class="w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
                                    <span class="ms-3">Statistiques</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </el-dialog-panel>
            </div>
        </dialog>
    </el-dialog>


    <aside class="max-lg:hidden bg-white fixed left-0 top-18 z-10 lg:w-64 h-1/3 py-6" aria-label="Sidebar">
        <div class="md:px-4">
            <h2 id="drawer-title" class="text-base font-semibold text-orange-700/65 lg:pl-4">Dashboard</h2>
        </div>
        <div class="flex justify-center h-full py-6 overflow-y-auto md:pl-4">
            <ul class="space-y-2 font-medium">
                <li class="active:text-orange-700/65">
                    <a href="/admin/orders" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                        <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 13h3.439a.991.991 0 0 1 .908.6 3.978 3.978 0 0 0 7.306 0 .99.99 0 0 1 .908-.6H20M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6M4 13l2-9h12l2 9M9 7h6m-7 3h8"/></svg>
                        <span class="flex-1 ms-3 whitespace-nowrap">Commandes</span>
                    </a>
                </li>
                <li class="text-orange-700/65">
                    <a href="/admin/employees" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                        <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M16 19h4a1 1 0 0 0 1-1v-1a3 3 0 0 0-3-3h-2m-2.236-4a3 3 0 1 0 0-4M3 18v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Zm8-10a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                        <span class="flex-1 ms-3 whitespace-nowrap">Employés</span>
                    </a>
                </li>
                <li class="active:text-orange-700/65">
                    <a href="/admin/products" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                        <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10V6a3 3 0 0 1 3-3v0a3 3 0 0 1 3 3v4m3-2 .917 11.923A1 1 0 0 1 17.92 21H6.08a1 1 0 0 1-.997-1.077L6 8h12Z"/></svg>
                        <span class="flex-1 ms-3 whitespace-nowrap">Produits</span>
                    </a>
                </li>
                <li class="active:text-orange-700/65">
                    <a href="/admin/comments" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                        <svg class="shrink-0 w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v14M9 5v14M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
                        <span class="flex-1 ms-3 whitespace-nowrap">Commentaires</span>
                    </a>
                </li>
                <li class="active:text-orange-700/65">
                    <a href="/admin/stats" class="flex items-center px-2 py-1.5 text-body rounded-base group">
                        <svg class="w-5 h-5 transition duration-75" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6.025A7.5 7.5 0 1 0 17.975 14H10V6.025Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 3c-.169 0-.334.014-.5.025V11h7.975c.011-.166.025-.331.025-.5A7.5 7.5 0 0 0 13.5 3Z"/></svg>
                        <span class="ms-3">Statistiques</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>


    <section class="p-4 mb-20 md:mt-10 md:mb-35 md:mx-10 lg:mt-30 lg:mb-40 lg:ml-78 lg:mr-20 shadow-md">
            <h2 class="text-orange-700/65 font-semibold text-xl my-8 lg:mt-4 lg:mb-8">Employés</h2>
            <div class="bg-orange-50 p-4 rounded-base">

                <div class="flex items-center justify-end rounded-base lg:pr-4 lg:py-2">
                    <button type="button" class="inline-flex items-center bg-orange-700/65 text-white hover:bg-amber-700 text-sm box-border shadow-xs font-medium leading-5 rounded-base px-3 py-2">
                        <svg class="w-3.5 h-3.5 me-1.5 -ms-0.5 fill-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 640 640">
                            <path d="M352 128C352 110.3 337.7 96 320 96C302.3 96 288 110.3 288 128L288 288L128 288C110.3 288 96 302.3 96 320C96 337.7 110.3 352 128 352L288 352L288 512C288 529.7 302.3 544 320 544C337.7 544 352 529.7 352 512L352 352L512 352C529.7 352 544 337.7 544 320C544 302.3 529.7 288 512 288L352 288L352 128z"/>
                        </svg>
                        <a href="/admin/addEmployee">Ajouter</a>
                    </button>
                </div>

                <div class="relative overflow-x-auto shadow-xs rounded-base border mt-6 mb-2 lg:my-4">
                    <table class="w-full text-sm text-left text-body">
                        <thead class="text-sm rounded-base">
                            <tr>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Prénom
                                </th>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Adresse email
                                </th>
                                <th scope="col" class="px-6 py-3 font-medium">
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-t">
                                <%  if(data.length>0){
                                    var i = 1;
                                    data.forEach(function(data){
                                    %>
                                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap"><%= data.id %></th>
                                <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap"><%= data.firstname %></th>
                                <td scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap"><%= data.email %></td>
                                <td scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                    <form method="POST" action="/admin/employees/<%= data.id %>">
                                        <button type="submit" class="inline-flex items-center bg-red-600 text-white hover:bg-red-700 box-border shadow-xs font-medium leading-5 rounded-base text-xs px-3 py-2">
                                            <svg class="w-3.5 h-3.5 fill-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 640 640">
                                                <path d="M262.2 48C248.9 48 236.9 56.3 232.2 68.8L216 112L120 112C106.7 112 96 122.7 96 136C96 149.3 106.7 160 120 160L520 160C533.3 160 544 149.3 544 136C544 122.7 533.3 112 520 112L424 112L407.8 68.8C403.1 56.3 391.2 48 377.8 48L262.2 48zM128 208L128 512C128 547.3 156.7 576 192 576L448 576C483.3 576 512 547.3 512 512L512 208L464 208L464 512C464 520.8 456.8 528 448 528L192 528C183.2 528 176 520.8 176 512L176 208L128 208zM288 280C288 266.7 277.3 256 264 256C250.7 256 240 266.7 240 280L240 456C240 469.3 250.7 480 264 480C277.3 480 288 469.3 288 456L288 280zM400 280C400 266.7 389.3 256 376 256C362.7 256 352 266.7 352 280L352 456C352 469.3 362.7 480 376 480C389.3 480 400 469.3 400 456L400 280z"/>
                                            </svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% i++; }) %>
                            <% } else { %>
                                <tr>
                                    <td class="col-span-2">No data found !</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            <div>
    </section>

    <script src="/deleteEmployee.js"></script>

<%- include ('../partials/footer'); -%>