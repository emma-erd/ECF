<%- include ('partials/header'); -%>

    <main class="md:mt-25 lg:mt-30 md:px-8 md:m-6 lg:mx-30 lg:px-10">

      <section class="grid grid-rows-3 flex justify-center justify-items-center m-4 pb-4 md:py-8">
        <h1 class="text-orange-700/65 font-semibold text-xl">Vite & Gourmand</h1>
        <div class="p-4 m-4">
          <img>
        </div>
        <div class="mx-8 md:px-8 lg:mx-20">
